{
  "manifest_version": 3,
  "name": "Boustrophedon",
  "version": "0.1.0",
  "description": "Alternate reading direction across lines.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "commands": {
    "toggle-boustro-enabled": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      },
      "description": "Toggle Boustrophedon mode globally"
    }
  },
  "action": {
    "default_title": "Boustrophedon Mode",
    "default_popup": "src/popup/popup.html"
  },
  "icons": {
    "128": "assets/images/128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js", "src/content/specified-sites.js"],
      "css": ["src/content/content-style.css"],
      "run_at": "document_idle"
    }
  ]
}
