tion-delay: -0.4s; }

.mw-spinner-container > div:nth-child(9) { transform: rotate(240deg); anima=
tion-delay: -0.3s; }

.mw-spinner-container > div:nth-child(10) { transform: rotate(270deg); anim=
ation-delay: -0.2s; }

.mw-spinner-container > div:nth-child(11) { transform: rotate(300deg); anim=
ation-delay: -0.1s; }

.mw-spinner-container > div:nth-child(12) { transform: rotate(330deg); anim=
ation-delay: 0s; }

